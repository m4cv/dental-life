{
  "name": "dental-life",
  "private": true,
  "version": "0.6.0",
  "description": "Dental Life — a mobile-first 3D life simulation of a fourth-year dental student in Yemen.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node scripts/test-pose.mjs && node scripts/test-shapes.mjs && node scripts/test-controls.mjs && node scripts/test-home.mjs && node scripts/test-street.mjs && node scripts/test-car.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.55.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
